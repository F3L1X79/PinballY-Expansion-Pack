# ============================================================
# Player settings. Copy this file to .env.local (same folder), then change
# only the lines you need. .env.local is ignored by git, so project updates
# never overwrite it. One KEY=value per line; quotes are optional; lines
# starting with # are comments. Keys you leave out keep their default.
# Save the file as UTF-8. Mistakes are written to PinballY.log and ignored.
# ============================================================

# --- Set these for your setup ---

# Interface language: en, fr, de, es, it or pt.
LANGUAGE=en
# Sounds: the pack ships most of them (see assets\sounds\CREDITS.md). To use
# your own, put it in assets\sounds\local\ (ignored by git) and give the path
# from the pack's folder, e.g. assets\sounds\local\launch.mp3, or a full path
# such as C:\PinballY\Media\Sounds\launch.mp3, with normal backslashes.
# Empty = no sound.
# Sound played when a table launches.
LAUNCH_SOUND_FILE=assets\sounds\launch.mp3
# Sound played with each Achievement Toast.
ACHIEVEMENT_SOUND_FILE=assets\sounds\achievement.wav
# Sound played when a player is greeted (on picking a Profile and at startup).
PROFILE_GREETING_SOUND_FILE=assets\sounds\profile_greeting.mp3
# Sound played once when a Confetti Shower starts (a completed Challenge, a
# Platinum Achievement, Mastery Level 10 or a new Collection Tier).
CONFETTI_SOUND_FILE=assets\sounds\confetti.wav
# Sound played once when the Fireworks start (a new Player Level).
FIREWORKS_SOUND_FILE=assets\sounds\fireworks.wav
# Sound played once when the Profile picker appears as the Startup Screen
# (none ships with the pack), e.g. assets\sounds\local\choose-your-character.mp3.
PROFILE_PICKER_SOUND_FILE=
# Manufacturer name you gave fictional/community VPX tables in PinballY.
# Used by the status line and the "Original Tables" filter.
COMMUNITY_TABLES_MANUFACTURER=VPX Community
# PinballY category of the Adult Tables, exactly as written in
# PinballY: a Profile marked "isChild" in its profile.json never sees them.
ADULT_CATEGORY=NSFW

# --- Optional preferences ---

# The first screen PinballY shows (the Startup Screen):
#   welcome       = the Welcome Screen (the default)
#   profilePicker = the Profile picker ("Who's playing?"), then the Welcome
#                   Screen for the Profile picked or kept; skipped while
#                   there is no Profile but Guest
#   wheel         = the bare wheel, the last active Profile greeted
# A screen whose Add-on is off gives way to the next one, from the Profile
# picker to the Welcome Screen to the wheel, as the PinballY log says.
STARTUP_SCREEN=welcome
# true = the random game jumps straight to the table, without the wheel animation.
SKIP_RANDOM_GAME_ANIMATION=false
# Total play time (in minutes) on a table before you're asked to rate it.
ASK_TO_RATE_AFTER_MINUTES_PLAYED=60
# Seconds an Achievement Toast stays fully visible: above 0, at most 60.
ACHIEVEMENT_TOAST_SECONDS=4
# Size of an Achievement Toast: 1 = the original card, 2 = twice as large; from 0.5 to 3, with a dot (1.6).
ACHIEVEMENT_TOAST_SCALE=1.0
# false = no Confetti Shower across the wheel screen with the toast of a
# completed Challenge, a Platinum Achievement, Mastery Level 10 on a table or
# a new Collection Tier, and no CONFETTI_SOUND_FILE, for a PC that struggles
# with it.
CONFETTI=true
# false = no Fireworks across the wheel screen with the toast of a new
# Player Level, and no FIREWORKS_SOUND_FILE, for a PC that struggles with
# them. Independent of CONFETTI.
FIREWORKS=true
# true = every PinballY menu title shown without a translation is written to
# PinballY.log, to spot what a new PinballY version or a new language misses.
LOG_UNTRANSLATED_MENU_TITLES=false

# --- Add-ons ---
# Each one can be turned off with false. All are on by default except Menu
# Cleanup. Grouped by what they touch; the order changes nothing.

# Players and progress
# "Change Player" in the main menu: pick whose plays and Achievements count.
ADD_ON_PROFILE_PICKER=true
# false also: Guest's plays count when a Challenge is drawn; the Challenge Card and the Mastery Bar are no longer placed under the Profile badge; the Welcome Screen has no Avatar choice, Avatar Frame or greeting by name.
# Welcome Screen at startup and after Change Player: stay on the table on the
# wheel, change player, or launch the Table of the Day, the Table of the Week
# or a random table.
ADD_ON_STARTUP_CHOICE_PROMPT=true
# false also: the Profile picker gives the Profile Greeting instead of leading to it; with ADD_ON_CUSTOM_MENU_COMMANDS=false too, no Random Game Achievements.
# Achievements.
ADD_ON_ACHIEVEMENTS=true
# false also: no Player Level shown anywhere.
# Records session stats used by the session Achievements.
ADD_ON_SESSION_STATS_TRACKER=true
# false also: no Sessions Achievements.
# The week's Challenge and your progress, under the Profile badge.
ADD_ON_CHALLENGES=true
# false also: no Challenges Achievements, no completed Challenges in the Profile Stats and Household Stats; the Mastery Bar no longer sits under the Challenge Card.
# Each table's Mastery Level for the active Profile, under the Challenge Card.
ADD_ON_TABLE_MASTERY=true
# false also: no Avatar Frames from Collection Tiers, no Collection Mastery line in the Household Stats.
# Credits each score that enters a ROM table's board to the Profile that played.
ADD_ON_HIGH_SCORES=true
# false also: no High Scores Achievements, no Lost Records on the Welcome Screen, no Table Records in the Profile Stats and Household Stats; PinballY's own High Scores come back (Menu Cleanup still removes its main menu entry).

# Wheel screen
# Table info (position, year, manufacturer, plays, play time) in the status line.
ADD_ON_STATUS_LINE_INFO=true
# The time at the top left of the wheel screen.
ADD_ON_CLOCK=true
# The gold arc under the wheel's icons, unless you have your own underlay.
ADD_ON_WHEEL_ARC=true

# Menus and filters
# Translates PinballY's own menus and messages into LANGUAGE.
ADD_ON_UI_TRANSLATION=true
# PinballY's menus (main, Exit, filters, power off, table setup and categories,
# Operator Menu) drawn in the pack's look instead of the native ones.
ADD_ON_DRAWN_MENUS=true
# false also: the pack's own menus and prompts fall back to PinballY's native menus.
# Table of the Day, Table of the Week, random table and Set Up Table in the main menu.
ADD_ON_CUSTOM_MENU_COMMANDS=true
# false also: with ADD_ON_STARTUP_CHOICE_PROMPT=false too, no Random Game Achievements.
# "Most Played Tables" filter in the main menu: your ten most played tables.
ADD_ON_HALL_OF_FAME=true
# false also: no "Most Played Tables" button on the Profile Stats.
# "Tables to Discover" filter in the main menu: the tables you never played.
ADD_ON_TABLES_TO_DISCOVER=true
# false also: no "Tables to Discover" button on the Profile Stats.
# "Hidden Tables" filter in the main menu, while at least one table is hidden.
ADD_ON_HIDDEN_TABLES=true
# "Original Tables" filter in the "Filter by Manufacturer" menu.
ADD_ON_CUSTOM_FILTER=true
# Off by default: removes Help and About from the Exit and Operator menus,
# Information, Flyer and Instruction Card from the main menu (and PinballY's own
# High Scores while ADD_ON_HIGH_SCORES=false), and the filter groups by system,
# last played and date added from "Filter Tables", for every Profile.
ADD_ON_MENU_CLEANUP=false

# Launching and playing a table
# Shows the backglass window at startup and hides it while a table runs.
ADD_ON_FORCE_BACKGLASS=true
# Hides the wheel while a table loads, avoiding a black flash.
ADD_ON_SEAMLESS_LAUNCH_OVERLAY=true
# Plays LAUNCH_SOUND_FILE when a table launches.
ADD_ON_PLAY_LAUNCH_SOUND=true
# Asks you to rate a table after ASK_TO_RATE_AFTER_MINUTES_PLAYED minutes.
ADD_ON_RATING_PROMPT=true
# Fills each table's empty ROM field from its script (vpxtool in the tools folder).
ADD_ON_TABLE_ROMS=true
